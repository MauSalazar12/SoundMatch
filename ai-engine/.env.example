# Illustrative values only. Preserve your existing .env and existing DB credentials.
DATABASE_URL=postgresql+psycopg://soundmatch:replace-me@localhost:5433/soundmatch
POSTGRES_USER=soundmatch
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=soundmatch
POSTGRES_VOLUME_NAME=ai-engine_postgres_data
DATABASE_URL_DOCKER=postgresql+psycopg://soundmatch:replace-me@postgres:5432/soundmatch

CLAP_CHECKPOINT=models/music_audioset_epoch_15_esc_90.14.pt
CLAP_CHECKPOINT_DOCKER=/models/music_audioset_epoch_15_esc_90.14.pt
CLAP_DEVICE=auto
CLAP_MODELS_PATH=./models
# Existing Hugging Face cache directory containing hub/models--roberta-base.
HF_CACHE_PATH=./models/huggingface
MAX_UPLOAD_BYTES=20971520
MAX_REQUEST_BYTES=21037056
MAX_AUDIO_SECONDS=60
INFERENCE_TIMEOUT_SECONDS=90
CANDIDATE_LIMIT=1000

# Spring Boot reads process environment, not this dotenv file when run locally.
AI_ENGINE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT=3s
AI_READ_TIMEOUT=100s
SERVER_PORT=8080

# Stage 4: use the same secret in Spring and FastAPI; restrict AI Engine to a private network.
INTERNAL_API_TOKEN=
WS_ALLOWED_ORIGINS=http://localhost:5173
STREAM_SAMPLE_RATES=44100,48000
STREAM_WINDOW_SECONDS=10
STREAM_HOP_SECONDS=5
STREAM_MAX_SESSIONS=32
STREAM_MAX_DURATION=30m
STREAM_IDLE_TIMEOUT=30s
STREAM_MAX_BINARY_BYTES=65536
STREAM_AUDIO_RATE_LIMIT=1.2
STREAM_BURST_SECONDS=2
STREAM_WORKERS=1
STREAM_QUEUE_CAPACITY=8
STREAM_RECOMMENDATION_LIMIT=5
STREAM_SEND_TIMEOUT_MS=5000
STREAM_SEND_BUFFER_BYTES=262144
